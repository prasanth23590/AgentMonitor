{
  "name": "agent-monitor",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "app": "electron . --dev",
    "start": "npm run build && electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^2.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.5.3",
    "vite": "^6.4.2"
  },
  "overrides": {
    "qs": ">=6.15.2"
  },
  "build": {
    "appId": "com.local.agent-monitor",
    "productName": "Agent Monitor",
    "asar": false,
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "assets/icon.ico",
      "assets/icon.svg",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
